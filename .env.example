# ---- Gemini ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash

# ---- WhatsApp ----
# `npm run groups` command eken group id eka hoyaganna
GROUP_ID=120363xxxxxxxxxxxxx@g.us

# ---- Google Sheets ----
# Sheet URL eke /d/ ha /edit atara kotasa
SHEET_ID=your_sheet_id_here
# Service account JSON file eke path eka
GOOGLE_CREDENTIALS=./credentials.json

# ---- Time windows (24h, Asia/Colombo) ----
MORNING_START=5
MORNING_END=12
EVENING_START=13
EVENING_END=24
